# PostgreSQL — local: poner DB_SSLMODE=disable
#             Neon:  poner el host de Neon y DB_SSLMODE=require
#             AWS RDS: poner endpoint RDS y DB_SSLMODE=require
DB_ENGINE=postgresql
DB_NAME=control_escolar
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Email notifications (rate-limited: máximo por destinatario por hora)
EMAIL_RATE_LIMIT_PER_HOUR=10
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your-email@example.com

# SMS notifications
SMS_BACKEND=twilio
SMS_FROM_NUMBER=+10000000000
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000

# Django
SECRET_KEY=django-insecure-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
